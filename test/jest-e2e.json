{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(htmlparser2|css-select|domhandler|entities|domelementtype|domutils|dom-serializer|boolbase|nth-check|css-what)/)"  ],
  "globals": {
    "Translator": {},
    "window": {}
  }
}