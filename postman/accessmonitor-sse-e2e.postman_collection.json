  "item": [
    {
      "name": "URL (GET /amp/eval/stream)",
      "item": [
        {
          "name": "Stream OK",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "SSE: [queued] -> processing -> completed (AuditReport). The server closes the connection afterward. In Postman, also use 'New > Server-Sent Events' to view events in real time.",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream?url={{testUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "{{testUrl}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function parseSse(text) {",
                  "  return text.split(/\\r?\\n\\r?\\n/).map(function (block) {",
                  "    var ev = {};",
                  "    block.split(/\\r?\\n/).forEach(function (l) {",
                  "      if (l.indexOf('event:') === 0) ev.event = l.slice(6).trim();",
                  "      else if (l.indexOf('data:') === 0) ev.data = (ev.data || '') + l.slice(5).trim();",
                  "    });",
                  "    if (ev.data) { try { ev.json = JSON.parse(ev.data); } catch (e) {} }",
                  "    return ev;",
                  "  }).filter(function (e) { return e.event && e.event !== 'ping'; });",
                  "}",
                  "const events = parseSse(pm.response.text());",
                  "const names = events.map(function (e) { return e.event; });",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is text/event-stream', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
                  "pm.test('X-Accel-Buffering: no', () => pm.expect(pm.response.headers.get('X-Accel-Buffering')).to.eql('no'));",
                  "pm.test('Cache-Control includes no-cache and no-transform', () => {",
                  "  const cc = pm.response.headers.get('Cache-Control');",
                  "  pm.expect(cc).to.include('no-cache'); pm.expect(cc).to.include('no-transform');",
                  "});",
                  "",
                  "pm.test('Ends with completed (stream closed by server)', () => pm.expect(names[names.length - 1]).to.eql('completed'));",
                  "pm.test('processing antes de completed', () => pm.expect(names.indexOf('processing')).to.be.within(0, names.indexOf('completed') - 1));",
                  "pm.test('No failed event', () => pm.expect(names).to.not.include('failed'));",
                  "const report = (events.find(function (e) { return e.event === 'completed'; }) || {}).json || {};",
                  "pm.test('AuditReport contains metadata, snapshot, telemetry, and scoring', () => {",
                  "  pm.expect(report).to.have.all.keys('metadata', 'snapshot', 'telemetry', 'scoring');",
                  "  pm.expect(report.metadata).to.have.all.keys('title', 'url', 'evaluatedAt');",
                  "  pm.expect(report.snapshot).to.have.all.keys('html', 'sizeInBytes', 'hash');",
                  "  pm.expect(report.telemetry).to.include.all.keys('totalHtmlTags', 'tagCounter', 'elementCounters', 'roles');",
                  "  pm.expect(report.scoring).to.include.all.keys('conform', 'totalTests', 'score', 'rulesOccurrences', 'assertionEvidence', 'conformanceResults');",
                  "});",
                  "pm.test('conform no formato n@n@n', () => pm.expect(report.scoring.conform).to.match(/^\\d+@\\d+@\\d+$/));"
                ]
              }
            }
          ]
        },
