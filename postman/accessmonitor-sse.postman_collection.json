                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ]
            }
          }
        },
        {
          "name": "Restricted URL (SSRF) -> 4xx",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream?url=http://127.0.0.1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "http://127.0.0.1"
                }
              ]
            }
          }
        },
        {
          "name": "Invalid Referer -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "https://referer-invalido.example"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream?url={{testUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "{{testUrl}}"
                }
              ]
            }
          }
        }
