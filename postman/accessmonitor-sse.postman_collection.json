{
  "info": {
    "_postman_id": "13ddc125-636b-4524-a4a7-44d4831fc9a6",
    "name": "AccessMonitor - SSE (manual)",
    "description": "Requests for manually exploring evaluation via queue + SSE. See the environment variables: baseUrl, referer, testUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "URL (GET /amp/eval/stream)",
      "item": [
        {
          "name": "Stream OK",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "SSE: [queued] -> processing -> completed (AuditReport). The server closes the connection afterward. In Postman, also use 'New > Server-Sent Events' to view events in real time.",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream?url={{testUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "{{testUrl}}"
                }
              ]
            }
          }
        },
        {
          "name": "Invalid URL -> 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/stream?url=nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "stream"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "nope"
                }
              ]
            }
          }
        },
        {
          "name": "Missing URL -> 400",
          "request": {
            "method": "GET",
