              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "html"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "File (POST /amp/eval/file)",
      "item": [
        {
          "name": "Stream OK (.html)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Referer",
                "value": "{{referer}}"
              }
            ],
            "description": "Select an .html file in the 'file' field. In the CLI, use --working-dir postman to resolve fixtures/.",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "file"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/sample.html"
                }
              ]
            }
          }
        },
        {
          "name": ".txt file -> 400",
          "request": {
