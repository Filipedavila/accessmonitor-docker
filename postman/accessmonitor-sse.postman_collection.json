    },
    {
      "name": "HTML (POST /amp/eval/html)",
      "item": [
        {
          "name": "Stream OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Referer",
                "value": "{{referer}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "description": "Consume with fetch streaming; EventSource only supports GET.",
            "url": {
              "raw": "{{baseUrl}}/amp/eval/html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "amp",
                "eval",
                "html"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"html\": \"<!DOCTYPE html><html lang=\\\"pt\\\"><head><meta charset=\\\"utf-8\\\"><title>E2E</title></head><body><main><h1>E2E</h1><img src=\\\"a.png\\\"></main></body></html>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Missing HTML -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
